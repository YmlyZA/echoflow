# EchoFlow backend configuration. Copy to `.env` and fill in real credentials.
# Provider secrets live only here (backend env) — never in the extension.

# CHANGE THIS. `dev-key` is published in this file, so every install that keeps
# it shares a publicly known credential. The backend listens on loopback only,
# which limits the blast radius to processes already on your machine — but any
# of them can then open /v1/realtime. Use any string you like; paste the same
# one into the extension.
ECHOFLOW_API_KEY=dev-key
ECHOFLOW_PORT=8787

# Listen address. Defaults to 127.0.0.1 (loopback-only) — that default is a
# security property; do not change it outside a container. The Docker image
# sets ECHOFLOW_HOST=0.0.0.0 itself so the server is reachable from the
# container's published port; you do not need to set this yourself.
# ECHOFLOW_HOST=127.0.0.1

# Provider selection. Default to fake for offline/local dev.
#   ASR:         fake | volcengine  (大模型流式语音识别 / sauc bigmodel)
#   Translation: fake | volcengine  (机器翻译大模型)
ECHOFLOW_ASR_PROVIDER=fake
ECHOFLOW_TRANSLATION_PROVIDER=fake

# --- Volcengine streaming ASR (大模型流式语音识别 / sauc bigmodel) ---
# To enable: set ECHOFLOW_ASR_PROVIDER=volcengine above, then fill these.
# NOTE: ASR credentials are an appid + access token — DIFFERENT from the
# translation VOLCENGINE_API_KEY below (which is a single key).
# VOLCENGINE_ASR_APP_KEY=
# VOLCENGINE_ASR_ACCESS_KEY=
# VOLCENGINE_ASR_RESOURCE_ID=volc.bigasr.sauc.duration
# VOLCENGINE_ASR_ENDPOINT=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel
# VOLCENGINE_ASR_VAD_MS=

# --- Volcengine machine translation (机器翻译大模型) ---
# To enable: set ECHOFLOW_TRANSLATION_PROVIDER=volcengine above, then fill this.
# VOLCENGINE_API_KEY=
# VOLCENGINE_TRANSLATION_ENDPOINT=https://openspeech.bytedance.com/api/v3/machine_translation/matx_translate
# VOLCENGINE_TRANSLATION_RESOURCE_ID=volc.speech.mt

# Interpretation mode (豆包同声传译 / AST) — separately subscribed; resource volc.service_type.10053
# New-console auth: a SINGLE API Key (sent as X-Api-Key) — NOT the ASR app-id/access-key pair.
VOLCENGINE_AST_API_KEY=
# Optional overrides:
# VOLCENGINE_AST_RESOURCE_ID=volc.service_type.10053
# VOLCENGINE_AST_ENDPOINT=wss://openspeech.bytedance.com/api/v4/ast/v2/translate

# --- History sync (SP4, optional) ---
# Cross-device subtitle history sync. Unset (default): sync routes are not
# registered and the backend stays stateless. Set to a file path to enable.
# The DB file contains your transcript text — keep it on your own machine.
#
# In Docker, use /data — the image creates it, owns it as the `node` user the
# container runs as, and declares it a volume. A relative path such as
# ./echoflow-history.db resolves to /app, which is root-owned, so the container
# would exit at boot; and without a mounted volume `docker run --rm` throws the
# database away. Run it as:
#   docker run --rm -p 127.0.0.1:8787:8787 --env-file .env \
#     -v echoflow-data:/data -e ECHOFLOW_HISTORY_DB=/data/history.db \
#     ghcr.io/ymlyza/echoflow-backend:latest
# Running from source instead? Then a relative path is fine.
# ECHOFLOW_HISTORY_DB=/data/history.db
